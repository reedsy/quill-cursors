{
  "name": "quill-cursors",
  "version": "6.0.0",
  "description": "A multi cursor module for Quill.",
  "keywords": [
    "quill",
    "module",
    "collaborative",
    "editing"
  ],
  "contributors": [
    "Pedro Machado Santa <pedro.santa@gmail.com>",
    "Alec Gibson <alec@reedsy.com>",
    "Oleg Petrov <oleg@fyvfyv.com>"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/quill-cursors.js",
  "types": "dist/index.d.ts",
  "style": "dist/quill-cursors.min.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/quill-cursors.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/quill-cursors.core.js"
    },
    "./css": "./dist/quill-cursors.min.css"
  },
  "files": [
    "dist",
    "!dist/styled.d.ts"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "npm run lint && NODE_ENV=production webpack && sass assets/quill-cursors.scss dist/quill-cursors.min.css --style=compressed --no-source-map",
    "lint": "eslint .",
    "start": "webpack serve --open",
    "test": "NODE_ENV=test jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reedsy/quill-cursors.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "css-loader": "^6.6.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^29.1.1",
    "quill": "^1.3.7",
    "quill-delta": "^4.2.2",
    "sass": "^1.49.7",
    "sass-loader": "^12.4.0",
    "style-loader": "^3.3.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4"
  }
}
